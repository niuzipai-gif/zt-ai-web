# Copy this file to aikey.env on the computer that runs the gateway.
# Never commit aikey.env or paste real keys into GitHub Pages.
MINIMAX_API_KEY=
MINIMAX_TEXT_MODEL=MiniMax-M3.1-Flash
# Keep streaming off until this deployment's voice/account and device checks pass.
VOICE_STREAMING_ENABLED=false
DEEPSEEK_API_KEY=
MMX_API_KEY=
CORS_ORIGIN=http://localhost:4173
PORT=8790
ADMIN_USERNAME=shali
ADMIN_PASSWORD=
# Optional: the desktop Agent reads these values from aikey.env in the project
# root or beside the portable/installed exe before each web lookup. Leave the
# key empty to use the keyless route/fallback.
FIRECRAWL_BASE_URL=https://api.firecrawl.dev/v2
FIRECRAWL_API_KEY=
