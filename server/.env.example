PORT=8790
CORS_ORIGIN=http://localhost:4173
# Multiple allowed origins can be comma-separated, for example:
# CORS_ORIGIN=http://localhost:4173,https://niuzipai-gif.github.io
# Keep false in every environment so missing credentials are visible instead of fake replies.
DEMO_FALLBACK=false
MINIMAX_API_KEY=
MINIMAX_TEXT_MODEL=MiniMax-M3
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
DEEPSEEK_API_KEY=
DEEPSEEK_TEXT_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
MMX_ENABLED=false
MMX_COMMAND=mmx
MMX_IMAGE_MODEL=image-01
MMX_IMAGE_ASPECT_RATIO=1:1
MMX_VIDEO_MODEL=MiniMax-Hailuo-2.3
MMX_VIDEO_DURATION=6
MMX_VIDEO_RESOLUTION=768P
MMX_VIDEO_POLL_MS=10000
MMX_VIDEO_MAX_POLLS=30
