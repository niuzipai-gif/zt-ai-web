{
  "name": "zt-ai-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "gateway": "node server/src/index.js",
    "gateway:health": "node -e \"fetch('http://localhost:8790/api/health').then(r=>r.text()).then(console.log)\"",
    "agent:start": "node agent-desktop/src/server.mjs",
    "agent:test": "node --test agent-desktop/src/*.test.mjs",
    "test": "node --test \"server/src/**/*.test.js\" \"src/**/*.test.js\"",
    "build": "vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "lucide-react": "latest",
    "mammoth": "^1.12.1",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest"
  }
}
