# For GitHub Pages or another static host, point this to the deployed gateway.
VITE_API_BASE_URL=
# Production example: https://your-zt-ai-gateway.example.com

# Local gateway runtime settings are read from aikey.env, not this file.
# Copy aikey.env.example to aikey.env and fill the values on the machine that runs the gateway.
# Administrator console: set ADMIN_USERNAME plus ADMIN_PASSWORD (or the salted hash pair) in aikey.env/Render.
